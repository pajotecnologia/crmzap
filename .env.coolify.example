# ==============================================================================
# VBSOLUTION CRM - Variáveis de Ambiente para o Coolify
# Cole estas variáveis na aba "Environment Variables" da sua Stack no Coolify
# ==============================================================================

# 1. Seus Domínios Públicos (sem barra no final)
BACKEND_URL=https://api.seudominio.com
FRONTEND_URL=https://app.seudominio.com

# 2. Banco de Dados PostgreSQL Interno
POSTGRES_DB=vbsolution
POSTGRES_USER=vbsolution
POSTGRES_PASSWORD=defina_uma_senha_forte_para_o_banco_aqui

# 3. Chaves Secretas de Sessão/Token (Gere com: openssl rand -hex 32)
JWT_SECRET=defina_um_segredo_jwt_longo_e_aleatorio_aqui
JWT_REFRESH_SECRET=defina_outro_segredo_jwt_refresh_longo_e_aleatorio_aqui
