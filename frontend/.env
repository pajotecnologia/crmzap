DISABLE_ESLINT_PLUGIN=true
GENERATE_SOURCEMAP=false
PORT=5090
BROWSER=none

# true  = modo local: login admin@local.dev / 123456 e dados salvos no localStorage (sem backend)
# false = usa o backend em REACT_APP_BACKEND_URL (banco de dados configurado no backend/.env)
REACT_APP_LOCAL_MODE=true
REACT_APP_BACKEND_URL=http://localhost:3000
