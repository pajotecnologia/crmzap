# =============================================================================
# Backend - variáveis de ambiente
# Copie este arquivo para `.env` e preencha com os dados do SEU ambiente.
# Nenhum valor abaixo é real: todos devem ser definidos por quem for implantar.
# =============================================================================

NODE_ENV=development
PORT=3000
PROXY_PORT=3000

# URL em que o backend é acessado (local ou pública HTTPS em produção)
BACKEND_URL=http://localhost:3000
# URL pública HTTPS (opcional) usada em webhooks (WhatsApp Oficial, Telegram, etc.)
PUBLIC_BACKEND_URL=
# URL do frontend (CORS e links enviados por e-mail)
FRONTEND_URL=http://localhost:5090
# Origens extras permitidas no CORS, separadas por vírgula (opcional)
FRONTEND_URLS=

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL recomendado)
# Use DATABASE_URL OU os campos DB_* individuais.
# Depois de configurar, rode:  npx sequelize db:migrate  (ou: npm run db:setup)
# -----------------------------------------------------------------------------
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=
# true para forçar SSL (bancos gerenciados na nuvem); false para desativar
DB_SSL=false
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO
DATABASE_URL=

DB_POOL_MAX=8
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# -----------------------------------------------------------------------------
# Autenticação (gere valores longos e aleatórios, ex.: openssl rand -base64 32)
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# -----------------------------------------------------------------------------
# Redis (filas, campanhas, agendamentos)
# -----------------------------------------------------------------------------
REDIS_URI=redis://localhost:6379
REDIS_URI_ACK=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000

SOCKET_ADMIN=false
USER_LIMIT=10000
CONNECTIONS_LIMIT=100000
CLOSED_SEND_BY_ME=true

# -----------------------------------------------------------------------------
# Meta (WhatsApp Oficial / Facebook / Instagram)
# -----------------------------------------------------------------------------
VERIFY_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_WHATSAPP_EMBEDDED_CONFIG_ID=
USE_WHATSAPP_OFICIAL=false
URL_API_OFICIAL=
TOKEN_API_OFICIAL=

# -----------------------------------------------------------------------------
# Telegram (opcional)
# -----------------------------------------------------------------------------
TELEGRAM_WEBHOOK_URL=
# TELEGRAM_FORCE_POLLING=true
# TELEGRAM_DISABLE_POLLING=true

# -----------------------------------------------------------------------------
# E-mail SMTP do sistema (recuperação de senha, notificações) - opcional
# -----------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# -----------------------------------------------------------------------------
# Inteligência Artificial
# As chaves de OpenAI / Claude / Gemini / Grok são cadastradas por empresa
# em Conexões. As variáveis abaixo são opcionais (assistente Brain da plataforma).
# -----------------------------------------------------------------------------
BRAIN_PLATFORM_OPENAI_API_KEY=
BRAIN_PLATFORM_ANTHROPIC_API_KEY=
BRAIN_PLATFORM_GEMINI_API_KEY=
BRAIN_PLATFORM_XAI_API_KEY=
OPENAI_RESPONSES_RUNTIME_ENABLED=true
AGENT_LLM_FIRST_RUNTIME_ENABLED=true
AI_INBOUND_QUEUE_ENABLED=false
AGENT_FILE_SEARCH_ENABLED=false
AGENT_OPENAI_KNOWLEDGE_INDEXING=true
# OPENAI_DEFAULT_CHAT_MODEL=
# OPENAI_DEFAULT_FAST_MODEL=
TRANSCRIBE_URL=

# Segredos de criptografia de credenciais salvas no banco (gere valores aleatórios)
ANTHROPIC_KEY_ENCRYPTION_SECRET=
GEMINI_KEY_ENCRYPTION_SECRET=
GROK_KEY_ENCRYPTION_SECRET=
FIGMA_KEY_ENCRYPTION_SECRET=
GITHUB_TOKEN_ENCRYPTION_SECRET=
GOOGLE_WORKSPACE_ENCRYPTION_SECRET=
API_CREDENTIAL_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Google Workspace OAuth (Drive, Sheets, Calendário) - opcional
# Redirect URI: BACKEND_URL/google/oauth/callback
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# -----------------------------------------------------------------------------
# GitHub OAuth - opcional
# Redirect URI: BACKEND_URL/github/oauth/callback
# -----------------------------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

# Terminal local do assistente Brain (opcional)
# BRAIN_LOCAL_TERMINAL_URL=http://127.0.0.1:9333
# CHROME_PATH=
